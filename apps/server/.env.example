# Template for apps/server. Copy to .env.local and fill in every value.
# All variables are required: the server refuses to start if one is missing
# or invalid (see src/config/env.schema.ts). Never commit .env.local.

# development | test | production
NODE_ENV=development
# HTTP port, 1-65535
PORT=3000

# MySQL connection; local values match infra/.env (see infra/README.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_road
DB_USER=my_road
DB_PASSWORD=change-me
